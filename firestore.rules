rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/sessions/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/moods/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
